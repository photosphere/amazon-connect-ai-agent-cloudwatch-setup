# Connect AI Agent 自动评估流水线 - 配置(模板)
#
#   cp config.env.example config.env
#   # 按需修改，然后:
#   ./deploy.sh
#
# 全部留空也能部署，默认值就是下面注释里写的值。

# ---------------------------------------------------------------------------
# 基础
# ---------------------------------------------------------------------------
# CloudFormation 栈名
STACK_NAME_CONF="connect-agentcore-eval"

# 部署区域。留空则依次回退 AWS_REGION / AWS_DEFAULT_REGION / aws configure / us-east-1
AWS_REGION=""

# Connect AI Agent 日志组名(由上一级 setup-connect-ai-agent-logs.sh 创建)
CONNECT_LOG_GROUP="/aws/connect/ai-agent-logs"

# 结果 S3 桶。留空则自动创建 connect-agentcore-eval-<account>-<region>
RESULTS_BUCKET=""

# AgentCore Observability 里的逻辑 runtime 名。转换后的 span/event 会写入
#   /aws/bedrock-agentcore/runtimes/<此名称>-DEFAULT
# 并以 <此名称>.DEFAULT 作为服务名被评估任务发现。
OBSERVABILITY_RUNTIME_NAME="connect-ai-agent"

# ---------------------------------------------------------------------------
# 拉取窗口
# ---------------------------------------------------------------------------
# 每次运行回看多少小时。配合每天一次的调度，24 即可覆盖全天。
LOOKBACK_HOURS="24"

# 额外往前多读的分钟数。用于兜住两类情况:
#   1) 跨窗口边界的会话(例如 23:58 接入、00:03 结束)
#   2) Connect -> CloudWatch 投递延迟，窗口关闭时最后几分钟还没落盘
# 重复不会造成重复评估: 已评估的 sessionId 记在 DynamoDB 台账里会被跳过。
OVERLAP_MINUTES="30"

# 会话「最后一个事件」需早于现在多少分钟，才认为通话已结束、可以评估。
# 防止对进行中的通话按半截对话打分(那会得到错误的分数，而不是缺失的分数)。
SETTLE_MINUTES="10"

# 已评估的 sessionId 记住多久(天)。超过后台账条目自动过期。
LEDGER_TTL_DAYS="30"

# WaitIndexed 是否也等待 aws/spans 里的 span 文档变为可查询(默认 true，两边都等)。
# 只有在确认「span 文档确实已经写进 aws/spans、但这一半的门永远打不开」时才改成
# false: 此时跳过这一半，让评估作业去报真实结果，而不是卡在等索引上超时。
REQUIRE_SPAN_INDEX="true"

# 超过多少天的会话直接跳过(会在 collect.json 的 skipped.too_old 中列出)。
# 14 是 CloudWatch PutLogEvents 的硬限制；调大只在「回填/用归档日志验证部署」时用,
# 此时依赖 ingest 步骤把老会话的时间戳平移进窗口(SHIFT_TIMESTAMPS，默认开启)。
MAX_AGE_DAYS="14"

# ---------------------------------------------------------------------------
# 评估内容
# ---------------------------------------------------------------------------
# ALL = 全部 13 个内置评估器(不含需要 ground truth 的 Trajectory*Match)。
# 也可写成逗号分隔的子集，例如:
#   EVALUATORS="Builtin.Helpfulness,Builtin.GoalSuccessRate,Builtin.ToolSelectionAccuracy"
#
# 成本提示: 评估是「每条 trace x 每个评估器」一次 LLM 调用，是本方案的主要成本项。
# API 单个任务最多 10 个评估器，因此 ALL 会并发跑 2 个任务。
EVALUATORS="ALL"

# Insights(公开预览)。留空则跳过 Insights 环节。
INSIGHTS="Builtin.Insight.FailureAnalysis,Builtin.Insight.UserIntent"

# 指导系统提示词优化的单个内置评估器(API 只允许 1 个)。
RECOMMENDATION_EVALUATOR="Helpfulness"

# ---------------------------------------------------------------------------
# 调度
# ---------------------------------------------------------------------------
# EventBridge Scheduler 表达式(UTC)。默认每天 03:00 UTC。
SCHEDULE_EXPRESSION="cron(0 3 * * ? *)"

# 是否启用定时调度。false 则只能用 run-now.sh 手动触发。
SCHEDULE_ENABLED_CONF="true"

# ---------------------------------------------------------------------------
# Transaction Search(账户级)
# ---------------------------------------------------------------------------
# AgentCore 批量评估通过 X-Ray / Transaction Search 的索引发现会话。
# 未开启时会话发现恒为 0，整条流水线会空转。deploy.sh 默认自动检查并开启。
ENABLE_TRANSACTION_SEARCH="true"

# span 索引采样率(1-100)。留空保持账户现状(默认 100)。
# 若 Connect 话务量很大、想控制 Transaction Search 成本，可下调。
INDEXING_PERCENTAGE=""

# ---------------------------------------------------------------------------
# 其他
# ---------------------------------------------------------------------------
# 本方案创建的日志组保留天数
LOG_RETENTION_DAYS="30"
